# Copy to `.env` and fill in the values. Never commit `.env`.
# These are the DEV environment values (public client-side values, already shipped in the
# front-end bundle). Production values are NOT kept in the repo: they live only in Vercel
# (Project Settings -> Environment Variables).

# API base URL (dev Lambda function URL, no trailing slash)
VITE_SERVER_URL=https://2bwoxyfwsfoqfolgmigabyaele0tegit.lambda-url.us-west-2.on.aws
VITE_HOST_API=https://2bwoxyfwsfoqfolgmigabyaele0tegit.lambda-url.us-west-2.on.aws

# Public account used by public pages (dev)
VITE_PUBLIC_ACCOUNT_ID=sportsmanagedev

# Cognito (dev user pool and its web app client)
VITE_AWS_AMPLIFY_USER_POOL_ID=us-west-2_CTvMrsxtC
VITE_AWS_AMPLIFY_USER_POOL_WEB_CLIENT_ID=691464gtme0ckndepbf6u7j1ll
VITE_AWS_AMPLIFY_REGION=us-west-2

# S3 asset base URL (optional)
VITE_ASSET_URL=

# Third-party API keys: leave empty here, set your own locally
VITE_MAGICBELL_API_KEY=
VITE_ONESIGNAL_APP_ID=
VITE_ONESIGNAL_SAFARI_WEB_ID=
