# Copy to `.env` and fill in the values. Never commit `.env`.
# These are the DEV environment values. Production values are NOT kept in the repo:
# they are set in Vercel (Project Settings -> Environment Variables).

# API base URL (dev API Gateway / custom domain, no trailing slash)
VITE_SERVER_URL=https://<dev-api-id>.execute-api.us-west-2.amazonaws.com

# S3 asset base URL (dev bucket)
VITE_ASSET_URL=https://<dev-assets-bucket>.s3.us-west-2.amazonaws.com

# Cognito (dev user pool and its web app client)
VITE_AWS_AMPLIFY_USER_POOL_ID=us-west-2_CTvMrsxtC
VITE_AWS_AMPLIFY_USER_POOL_WEB_CLIENT_ID=<dev-web-client-id>
VITE_AWS_AMPLIFY_REGION=us-west-2

# In-app notifications (optional)
VITE_MAGICBELL_API_KEY=
